{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "0.875rem" },
        { "name": "Medium", "slug": "medium", "size": "1.125rem" },
        { "name": "Large", "slug": "large", "size": "clamp(1.75rem, 2vw, 2.5rem)" },
        { "name": "Extra Large", "slug": "x-large", "size": "clamp(2.5rem, 5vw, 4rem)" }
      ],
      "fontFamilies": [
        { "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif", "name": "System", "slug": "system-font" }
      ]
    },
    "color": {
      "palette": [
        { "slug": "base", "color": "#f7f2ea", "name": "Base" },
        { "slug": "contrast", "color": "#171717", "name": "Contrast" },
        { "slug": "primary", "color": "#7d5837", "name": "Primary" },
        { "slug": "secondary", "color": "#d7b98d", "name": "Secondary" },
        { "slug": "tertiary", "color": "#efe5d5", "name": "Tertiary" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-font)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.5rem"
    }
  },
  "templateParts": [
    {
      "name": "Header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "Footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
