{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "0.875rem" },
        { "name": "Medium", "slug": "medium", "size": "1.125rem" },
        { "name": "Large", "slug": "large", "size": "clamp(1.75rem, 2vw, 2.5rem)" },
        { "name": "Extra Large", "slug": "x-large", "size": "clamp(2.5rem, 5vw, 4rem)" }
      ],
      "fontFamilies": [
        {
          "fontFamily": "\"Barlow Semi Condensed\", \"Arial Narrow\", Arial, sans-serif",
          "name": "Barlow Semi Condensed",
          "slug": "barlow-semi-condensed",
          "fontFace": [
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-regular.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-medium.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-semibold.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-bold.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-italic.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "italic",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-medium-italic.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "italic",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-semibold-italic.woff2"]
            },
            {
              "fontFamily": "Barlow Semi Condensed",
              "fontStyle": "italic",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/barlow-semi-condensed-bold-italic.woff2"]
            }
          ]
        },
        {
          "fontFamily": "\"Averia Serif Libre\", Georgia, serif",
          "name": "Averia Serif Libre",
          "slug": "averia-serif-libre",
          "fontFace": [
            {
              "fontFamily": "Averia Serif Libre",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/averia-serif-libre-regular.woff2"]
            },
            {
              "fontFamily": "Averia Serif Libre",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/averia-serif-libre-bold.woff2"]
            }
          ]
        }
      ]
    },
    "color": {
      "palette": [
        { "slug": "base", "color": "#f7f2ea", "name": "Base" },
        { "slug": "contrast", "color": "#171717", "name": "Contrast" },
        { "slug": "primary", "color": "#7d5837", "name": "Primary" },
        { "slug": "secondary", "color": "#d7b98d", "name": "Secondary" },
        { "slug": "tertiary", "color": "#efe5d5", "name": "Tertiary" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--barlow-semi-condensed)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "400",
      "letterSpacing": "normal"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--averia-serif-libre)",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "normal"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--averia-serif-libre)",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "normal"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--averia-serif-libre)",
          "fontWeight": "400",
          "lineHeight": "1.2",
          "letterSpacing": "normal"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--averia-serif-libre)",
          "fontWeight": "400",
          "lineHeight": "1.2",
          "letterSpacing": "normal"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--averia-serif-libre)",
          "fontWeight": "400",
          "lineHeight": "1.2",
          "letterSpacing": "normal"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--averia-serif-libre)",
          "fontWeight": "400",
          "lineHeight": "1.2",
          "letterSpacing": "normal"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem"
    }
  },
  "templateParts": [
    {
      "name": "Header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "Footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
